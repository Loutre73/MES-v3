# Paramètres propres au site. mesctl install crée site.env à partir de ce fichier
# et génère les mots de passe marqués <auto>.

# Version du produit déployée (mise à jour par mesctl update)
MES_VERSION=0.1.0
MES_REGISTRY=ghcr.io/loutre73

# Automate
OPCUA_ENDPOINT=opc.tcp://192.168.0.1:4840
# Sécurité OPC UA (vide = aucune). Exemple :
# OPCUA_SECURITY=Basic256Sha256,SignAndEncrypt,/certs/client_cert.der,/certs/client_key.pem
OPCUA_SECURITY=
OPCUA_USERNAME=
OPCUA_PASSWORD=
# Compte OPC UA utilisé uniquement pour écrire les recettes (vide = même compte que la lecture)
OPCUA_WRITE_USERNAME=
OPCUA_WRITE_PASSWORD=
OPCUA_CERT_DIR=./certs
BROWSE_ROOT=PLC_1/DataBlocksGlobal

# Conservation : données brutes, agrégats minute, agrégats horaires
# (les KPI de production du MES sont conservés 3 ans : paramètre kpi_conservation dans l'application)
# La purge passe toutes les heures et supprime des chunks entiers : les données brutes sont gardées
# entre HISTORIAN_RETENTION et HISTORIAN_RETENTION + HISTORIAN_CHUNK_INTERVAL
# (ex. conservation courte : HISTORIAN_RETENTION=9 hours et HISTORIAN_CHUNK_INTERVAL=1 hour).
HISTORIAN_RETENTION=1 year
HISTORIAN_CHUNK_INTERVAL=6 hours
AGGREGATE_1MIN_RETENTION=1 year
AGGREGATE_1H_RETENTION=3 years

# Base de données (shared_buffers : environ 25 % de la RAM de la VM)
DB_SHARED_BUFFERS=8GB
DB_PASSWORD=<auto>
MES_READER_PASSWORD=<auto>

# Application web (MES + Grafana sous /grafana/)
WEB_PORT=80
SITE_TIMEZONE=Europe/Paris
# Passer à true derrière un reverse proxy HTTPS
COOKIE_SECURE=false
SECRET_KEY=<auto>
# Mot de passe du compte local "admin" (secours, utilisable même sans AD)
ADMIN_PASSWORD=<auto>
GRAFANA_ADMIN_PASSWORD=<auto>

# Active Directory (vide = comptes locaux seulement)
# AUTH_LDAP_URL=ldaps://dc01.usine.local
# AUTH_LDAP_DOMAIN=USINE
# AUTH_LDAP_BASE_DN=DC=usine,DC=local
# Groupes AD -> rôles MES (operateur, chef_equipe, maintenance, admin)
# AUTH_LDAP_GROUP_ROLES=MES_Admins=admin;MES_Chefs=chef_equipe;MES_Maintenance=maintenance;MES_Operateurs=operateur
AUTH_LDAP_URL=
AUTH_LDAP_DOMAIN=
AUTH_LDAP_BASE_DN=
AUTH_LDAP_GROUP_ROLES=

# Profils Docker Compose actifs : sim (simulateur), monitoring (surveillance technique, tableau Grafana « Système »)
# Activer ou couper la surveillance : ./mesctl monitoring on|off
COMPOSE_PROFILES=
# Conservation des métriques techniques (Prometheus) : durée et volume disque maximal
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=2GB

# Sauvegardes
BACKUP_DIR=./backups
BACKUP_KEEP=14
