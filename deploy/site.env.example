# Paramètres propres au site. mesctl install crée site.env à partir de ce fichier
# et génère les mots de passe marqués <auto>.

# Version du produit déployée (mise à jour par mesctl update)
MES_VERSION=0.1.0
MES_REGISTRY=ghcr.io/loutre73

# Automate
OPCUA_ENDPOINT=opc.tcp://192.168.0.1:4840
# Sécurité OPC UA (vide = aucune). Exemple :
# OPCUA_SECURITY=Basic256Sha256,SignAndEncrypt,/certs/client_cert.der,/certs/client_key.pem
OPCUA_SECURITY=
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_CERT_DIR=./certs
BROWSE_ROOT=PLC_1/DataBlocksGlobal

# Conservation : données brutes, agrégats minute, agrégats horaires
# (les KPI de production du MES sont conservés 3 ans, à partir du lot 2)
HISTORIAN_RETENTION=1 year
AGGREGATE_1MIN_RETENTION=1 year
AGGREGATE_1H_RETENTION=3 years

# Base de données (shared_buffers : environ 25 % de la RAM de la VM)
DB_SHARED_BUFFERS=8GB
DB_PASSWORD=<auto>
MES_READER_PASSWORD=<auto>

# Grafana
GRAFANA_ADMIN_PASSWORD=<auto>
GRAFANA_PORT=3000

# Profils Docker Compose actifs : sim (simulateur), monitoring (Prometheus)
COMPOSE_PROFILES=

# Sauvegardes
BACKUP_DIR=./backups
BACKUP_KEEP=14
