{
  "uid": "mes-collecte",
  "title": "Collecte - santé",
  "tags": [
    "mes-v3"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tags actifs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "historian"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "historian"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS tags FROM catalog.tag WHERE enabled AND historize"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Points par seconde (1 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "historian"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "historian"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) / 60.0 AS pts FROM historian.value WHERE time > now() - interval '1 minute'"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Retard de collecte",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "historian"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "historian"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT extract(epoch FROM now() - max(time)) AS retard FROM historian.value WHERE time > now() - interval '1 hour'"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Taille de l'historian",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "historian"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "historian"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT hypertable_size('historian.value') AS taille"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Points écrits par seconde",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "historian"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "historian"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time_bucket('10 seconds', time) AS time, count(*) / 10.0 AS \"points/s\"\nFROM historian.value\nWHERE $__timeFilter(time)\nGROUP BY 1 ORDER BY 1"
        }
      ]
    }
  ]
}