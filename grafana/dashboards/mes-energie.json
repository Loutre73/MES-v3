{
 "uid": "mes-energie",
 "title": "Énergie",
 "tags": [
  "mes-v3"
 ],
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "timezone": "browser",
 "editable": false,
 "templating": {
  "list": [
   {
    "name": "ligne",
    "label": "Ligne",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "historian"
    },
    "multi": true,
    "includeAll": true,
    "query": "SELECT m.name FROM catalog.machine m JOIN catalog.machine_type t ON t.id = m.type_id WHERE t.code = 'ligne' AND m.enabled ORDER BY 1",
    "refresh": 1,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Consommation",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "historian"
   },
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "historian"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT sum(k.energy_kwh) AS kwh FROM mes.shift_kpi k JOIN mes.shift s ON s.id = k.shift_id JOIN catalog.machine m ON m.id = s.line_id WHERE $__timeFilter(s.starts_at) AND m.name IN (${ligne:sqlstring}) AND s.starts_at < now()"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Ratio kWh/t",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "historian"
   },
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 8,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "historian"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT sum(k.energy_kwh) / nullif(sum(k.tonnage_t), 0) AS r FROM mes.shift_kpi k JOIN mes.shift s ON s.id = k.shift_id JOIN catalog.machine m ON m.id = s.line_id WHERE $__timeFilter(s.starts_at) AND m.name IN (${ligne:sqlstring}) AND s.starts_at < now()"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Puissance appelée",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "historian"
   },
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 16,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatt",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "historian"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT sum(last) AS kw FROM (SELECT DISTINCT ON (g.id) v.value AS last FROM catalog.tag g JOIN historian.value v ON v.tag_id = g.id WHERE g.role = 'puissance' AND g.enabled AND v.time > now() - interval '15 minutes' ORDER BY g.id, v.time DESC) x"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Puissance totale (moyenne minute)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "historian"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatt"
    },
    "overrides": []
   },
   "options": {},
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "historian"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT a.bucket AS time, sum(a.avg) AS \"puissance\" FROM historian.value_1min a JOIN catalog.tag g ON g.id = a.tag_id WHERE g.role = 'puissance' AND $__timeFilter(a.bucket) GROUP BY 1 ORDER BY 1"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "kWh/t par poste",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "historian"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "showPoints": "always",
      "pointSize": 5
     }
    },
    "overrides": []
   },
   "options": {},
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "historian"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT s.starts_at AS time, m.name AS metric, k.kwh_per_t AS value FROM mes.shift_kpi k JOIN mes.shift s ON s.id = k.shift_id JOIN catalog.machine m ON m.id = s.line_id WHERE $__timeFilter(s.starts_at) AND m.name IN (${ligne:sqlstring}) AND s.starts_at < now() AND k.kwh_per_t IS NOT NULL ORDER BY 1"
    }
   ]
  },
  {
   "id": 6,
   "type": "barchart",
   "title": "Consommation par compteur (kWh)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "historian"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "xField": "compteur"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "historian"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT c.name || coalesce(' · ' || (c.attributes->>'usage'), '') AS compteur, round(sum(e.kwh)) AS kwh FROM mes.energy_shift e JOIN mes.shift s ON s.id = e.shift_id JOIN catalog.machine c ON c.id = e.meter_id WHERE $__timeFilter(s.starts_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
    }
   ]
  }
 ]
}