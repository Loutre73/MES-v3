     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT sum(k.tonnage_t) / nullif(sum(k.target_t), 0) AS r FROM mes.shift_kpi k JOIN mes.shift s ON s.id = k.shift_id JOIN catalog.machine m ON m.id = s.line_id WHERE $__timeFilter(s.starts_at) AND m.name IN (${ligne:sqlstring}) AND s.starts_at < now()"
