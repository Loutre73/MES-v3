   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "historian"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT date_trunc('day', s.starts_at)::date::text AS jour, sum(k.tonnage_t) AS \"réalisé\", sum(k.target_t) AS objectif FROM mes.shift_kpi k JOIN mes.shift s ON s.id = k.shift_id JOIN catalog.machine m ON m.id = s.line_id WHERE $__timeFilter(s.starts_at) AND m.name IN (${ligne:sqlstring}) AND s.starts_at < now() GROUP BY 1 ORDER BY 1"
    }
   ]
  },
  {
   "id": 7,
   "type": "table",
   "title": "Postes",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "historian"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "historian"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT s.starts_at AS \"début\", m.name AS ligne, s.team AS \"équipe\", k.target_t AS objectif, k.tonnage_t AS \"réalisé\", k.availability AS dispo, k.performance AS perf, k.oee AS trs, k.kwh_per_t AS \"kWh/t\", k.stop_count AS \"arrêts\", k.unqualified_count AS \"à qualifier\" FROM mes.shift_kpi k JOIN mes.shift s ON s.id = k.shift_id JOIN catalog.machine m ON m.id = s.line_id WHERE $__timeFilter(s.starts_at) AND m.name IN (${ligne:sqlstring}) AND s.starts_at < now() ORDER BY 1 DESC, 2"
    }
   ]
  },
  {
