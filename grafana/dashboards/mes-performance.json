    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "historian"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT cause, lpad((s / 86400)::text, 2, '0') || ':' || to_char(make_interval(secs => s % 86400), 'HH24:MI:SS') AS \"durée\", n AS \"arrêts\", s AS part FROM (SELECT coalesce(c.label, 'Non qualifié') AS cause, round(sum(extract(epoch FROM coalesce(e.ends_at, now()) - e.starts_at)))::bigint AS s, count(*) AS n FROM mes.stop_event e JOIN catalog.machine m ON m.id = e.machine_id LEFT JOIN mes.stop_cause c ON c.id = e.cause_id WHERE NOT e.planned AND $__timeFilter(e.starts_at) AND m.name IN (${ligne:sqlstring}) GROUP BY 1) x ORDER BY s DESC LIMIT 15"
    }
   ]
