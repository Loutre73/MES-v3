    "label": "Ligne",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "historian"
    },
    "multi": true,
    "includeAll": true,
    "query": "SELECT m.name FROM catalog.machine m JOIN catalog.machine_type t ON t.id = m.type_id WHERE t.code = 'ligne' AND m.enabled ORDER BY 1",
